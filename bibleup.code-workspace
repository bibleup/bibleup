{
	"folders": [
		{
			"name": "Root",
			"path": "."
		},
		{
			"name": "BibleUp Core 🧰",
			"path": "bibleup"
		},
		{
			"name": "BibleUp Demo 📱",
			"path": "demo"
		}
	],
	"settings": {
		"files.exclude": {
			"**/node_modules": true,
			"**/.github": true,
			"**/demo": true, // hide demo folder in root
			"**/bibleup": true // hide bibleup folder in root
		},
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit"
		},
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true,
		"eslint.validate": [
			"javascript",
			"typescript"
		],
		"eslint.nodePath": "/c/Users/Hp/AppData/Roaming/npm/pnpm",
		"eslint.workingDirectories": [
			"./bibleup"
		]
	},
	"extensions": {
		"recommendations": [
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode"
		]
	}
}