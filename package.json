{
  "name": "@bibleup/bibleup",
  "version": "1.1.0",
  "description": "A tool for converting Bible references on a webpage to links with an accessible popover",
  "type": "module",
  "browser": "./dist/umd/bibleup.min.js",
  "module": "./dist/bibleup.esm.js",
  "unpkg": "./dist/umd/bibleup.min.js",
  "types": "./dist/bibleup.d.ts",
  "style": "./dist/css/bibleup.css",
  "exports": {
    ".": {
      "types": "./dist/bibleup.d.ts",
      "import": "./dist/bibleup.esm.js"
    },
    "./css": {
      "types": "./dist/bibleup.d.ts",
      "default": "./dist/css/bibleup.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "echo \"No test specified\"",
    "build": "pnpm run format && pnpm run lint && pnpm run clean && rollup --config",
    "lint": "eslint --fix ./bibleup",
    "format": "prettier bibleup/ --write",
    "clean": "rimraf dist",
    "dev": "pnpm --filter demo run dev",
    "release": "pnpm run build && release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bibleup/bibleup.js.git"
  },
  "keywords": [
    "bible",
    "scripture",
    "tooltip",
    "popup",
    "references",
    "popover",
    "javascript"
  ],
  "author": "BibleUp",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Bibleup/bibleup.js/issues"
  },
  "homepage": "https://bibleup.netlify.app",
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "trailingComma": "none",
    "printWidth": 80
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:bump": "pnpm run build"
    }
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^10.0.5",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/rollup-plugin-less": "^1.1.5",
    "core-js": "^3.48.0",
    "del": "^8.0.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.3.0",
    "prettier": "3.8.1",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.2",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-less": "^1.1.3",
    "rollup-plugin-license": "^3.6.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
